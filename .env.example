MYSQL_DATABASE=freshora
MYSQL_USER=freshora_app
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-root-password
MYSQL_PORT=3307

# The Spring Boot backend accepts these directly. DB_* take precedence over
# MYSQL_* so local Docker and a separately-run backend can share one .env file.
DB_URL=jdbc:mysql://localhost:3307/freshora
DB_USERNAME=freshora_app
DB_PASSWORD=replace-with-a-strong-local-password

FRESHORA_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRESHORA_JWT_ACCESS_EXPIRATION=900000
FRESHORA_JWT_REFRESH_EXPIRATION=604800000
FRESHORA_ADMIN_EMAIL=
FRESHORA_ADMIN_PASSWORD=
FRESHORA_FRONTEND_URL=http://localhost:3000
# Use false only for local HTTP development; keep true for HTTPS deployments.
FRESHORA_COOKIE_SECURE=true
FRESHORA_COOKIE_SAME_SITE=Lax

APP_FRONTEND_URL=http://localhost:5173
FILE_STORAGE_LOCATION=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=30MB

# Gmail SMTP: use a Gmail App Password, never the normal account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=Freshora
