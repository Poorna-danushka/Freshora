%% CURRENT DATABASE: tables created by Flyway V1-V3. Columns without an explicit
%% VARCHAR length use VARCHAR(255); all DATETIME columns use DATETIME(6).
erDiagram
  USERS {
    BIGINT id PK "AUTO_INCREMENT"
    VARCHAR first_name
    VARCHAR last_name
    VARCHAR email UK
    VARCHAR password
    VARCHAR phone "nullable"
    VARCHAR profile_image_url "nullable"
    VARCHAR role "CUSTOMER/STORE_MANAGER/STORE_STAFF/DRIVER/ADMIN"
    BOOLEAN enabled
    VARCHAR status "PENDING/ACTIVE/DISABLED/SUSPENDED"
    DATETIME created_at
    DATETIME updated_at
  }
  ADDRESSES {
    BIGINT id PK "AUTO_INCREMENT"
    BIGINT user_id FK
    VARCHAR label
    VARCHAR recipient_name
    VARCHAR phone
    VARCHAR address_line1
    VARCHAR address_line2 "nullable"
    VARCHAR city
    VARCHAR district
    VARCHAR postal_code "nullable"
    DOUBLE latitude "nullable"
    DOUBLE longitude "nullable"
    BOOLEAN is_default
    DATETIME created_at
    DATETIME updated_at
  }
  REFRESH_TOKENS {
    BIGINT id PK "AUTO_INCREMENT"
    BIGINT user_id FK
    VARCHAR token_id UK
    DATETIME expires_at
    DATETIME created_at
    DATETIME revoked_at "nullable"
  }
  PASSWORD_RESET_TOKENS {
    BIGINT id PK "AUTO_INCREMENT"
    BIGINT user_id FK
    VARCHAR token_hash
    DATETIME expires_at
    DATETIME used_at "nullable"
    DATETIME created_at
  }
  ACCOUNT_SETUP_TOKENS {
    BIGINT id PK "AUTO_INCREMENT"
    BIGINT user_id FK
    VARCHAR token_hash
    DATETIME expires_at
    DATETIME used_at "nullable"
    DATETIME created_at
  }
  STORE_APPLICATIONS {
    BIGINT id PK "AUTO_INCREMENT"
    BIGINT applicant_user_id FK "nullable"
    VARCHAR applicant_name
    VARCHAR email
    VARCHAR contact_number
    VARCHAR alternate_contact_number "nullable"
    VARCHAR preferred_contact_method
    VARCHAR applicant_notes "nullable"
    VARCHAR store_name
    VARCHAR store_contact_number
    VARCHAR store_email "nullable"
    VARCHAR store_address
    VARCHAR city
    VARCHAR province "nullable"
    VARCHAR postal_code "nullable"
    VARCHAR store_type
    VARCHAR registration_number "nullable"
    VARCHAR store_description "nullable"
    VARCHAR status
    BIGINT reviewed_by FK "nullable"
    DATETIME reviewed_at "nullable"
    VARCHAR review_notes "nullable"
    DATETIME submitted_at
    DATETIME updated_at
  }
  DRIVER_APPLICATIONS {
    BIGINT id PK "AUTO_INCREMENT"
    BIGINT applicant_user_id FK "nullable"
    VARCHAR full_name
    VARCHAR email
    VARCHAR contact_number
    VARCHAR date_of_birth
    VARCHAR address
    VARCHAR city
    VARCHAR province "nullable"
    VARCHAR emergency_contact_name "nullable"
    VARCHAR emergency_contact_number "nullable"
    VARCHAR vehicle_type
    VARCHAR vehicle_registration_number
    VARCHAR vehicle_make "nullable"
    VARCHAR vehicle_model "nullable"
    VARCHAR vehicle_year "nullable"
    VARCHAR vehicle_color "nullable"
    VARCHAR ownership_type
    VARCHAR preferred_area
    VARCHAR preferred_working_days "nullable"
    VARCHAR preferred_working_hours "nullable"
    VARCHAR delivery_experience "nullable"
    BOOLEAN has_smartphone
    BOOLEAN has_delivery_bag "nullable"
    VARCHAR additional_notes "nullable"
    VARCHAR status
    BIGINT reviewed_by FK "nullable"
    DATETIME reviewed_at "nullable"
    VARCHAR review_notes "nullable"
    DATETIME submitted_at
    DATETIME updated_at
  }
  APPLICATION_DOCUMENTS {
    BIGINT id PK "AUTO_INCREMENT"
    VARCHAR application_type
    BIGINT application_id "polymorphic owner; no FK"
    VARCHAR document_type
    VARCHAR original_file_name
    VARCHAR storage_key UK
    VARCHAR content_type
    BIGINT file_size
    DATETIME uploaded_at
  }
  APPLICATION_REVIEW_HISTORY {
    BIGINT id PK "AUTO_INCREMENT"
    VARCHAR application_type
    BIGINT application_id "polymorphic owner; no FK"
    VARCHAR previous_status "nullable"
    VARCHAR new_status
    BIGINT reviewed_by FK "nullable"
    VARCHAR note "nullable"
    DATETIME created_at
  }
  ORDERS {
    CHAR id PK "36-character UUID"
    VARCHAR order_number UK
    BIGINT customer_id FK
    CHAR store_id "36-character UUID; no FK"
    BIGINT address_id FK
    JSON address_snapshot
    VARCHAR status
    DECIMAL subtotal
    DECIMAL delivery_fee
    DECIMAL discount_amount
    DECIMAL total_amount
    DECIMAL commission_rate
    DECIMAL commission_amount
    DECIMAL store_amount
    INT version
    DATETIME created_at
    DATETIME cancelled_at "nullable"
  }
  ORDER_ITEMS {
    CHAR id PK "36-character UUID"
    CHAR order_id FK
    CHAR product_id "36-character UUID; no FK"
    CHAR substitute_product_id "nullable; no FK"
    VARCHAR product_name
    DECIMAL unit_price
    INT quantity
    DECIMAL line_total
    VARCHAR pick_status
  }
  ORDER_EVENTS {
    CHAR id PK "36-character UUID"
    CHAR order_id FK
    VARCHAR event_type
    VARCHAR from_status "nullable"
    VARCHAR to_status
    INT version "UK with order_id"
    JSON payload
    DATETIME created_at
  }
  IDEMPOTENCY_RECORDS {
    CHAR id PK "36-character UUID"
    VARCHAR idem_key
    BIGINT user_id FK
    VARCHAR operation
    VARCHAR request_hash
    VARCHAR status
    JSON response "nullable"
    CHAR order_id FK "nullable"
    DATETIME expires_at
    DATETIME created_at
  }
  OUTBOX_EVENTS {
    CHAR id PK "36-character UUID"
    VARCHAR aggregate_type
    CHAR aggregate_id "36-character UUID"
    VARCHAR event_type
    INT version
    JSON payload
    VARCHAR status
    DATETIME created_at
    DATETIME published_at "nullable"
    INT attempts
    VARCHAR last_error "nullable"
  }
  PAYMENTS {
    CHAR id PK "36-character UUID"
    CHAR order_id FK
    VARCHAR status
    DECIMAL amount
    VARCHAR payment_method
    VARCHAR provider_ref UK "nullable"
    VARCHAR idempotency_key UK "nullable"
    INT attempts
    DATETIME updated_at
  }

  USERS ||--o{ ADDRESSES : owns
  USERS ||--o{ REFRESH_TOKENS : owns
  USERS ||--o{ PASSWORD_RESET_TOKENS : owns
  USERS ||--o{ ACCOUNT_SETUP_TOKENS : owns
  USERS |o--o{ STORE_APPLICATIONS : applies
  USERS |o--o{ STORE_APPLICATIONS : reviews
  USERS |o--o{ DRIVER_APPLICATIONS : applies
  USERS |o--o{ DRIVER_APPLICATIONS : reviews
  USERS |o--o{ APPLICATION_REVIEW_HISTORY : reviews
  USERS ||--o{ ORDERS : places
  USERS ||--o{ IDEMPOTENCY_RECORDS : submits
  ADDRESSES ||--o{ ORDERS : used_by
  ORDERS ||--o{ ORDER_ITEMS : contains
  ORDERS ||--o{ ORDER_EVENTS : history
  ORDERS |o--o{ IDEMPOTENCY_RECORDS : result_of
  ORDERS ||--o{ PAYMENTS : paid_by
%% Existing unique keys: users.email, refresh_tokens.token_id, application_documents.storage_key,
%% orders.order_number, (order_events.order_id,version), (idempotency_records.user_id,idem_key,operation),
%% payments.provider_ref, payments.idempotency_key. Password/setup token hashes are not unique.
%% Existing FKs are only the drawn relationships; application_documents.application_id is polymorphic
%% and has no FK. orders.store_id and order_items.product_id/substitute_product_id have no FKs.
%% User/address/auth/application IDs are BIGINT AUTO_INCREMENT; order-domain UUIDs are CHAR(36).
%% JSON columns use MySQL JSON; timestamps use DATETIME(6); coordinates are DOUBLE.
%% Roles are stored in one users.role column. V3 updates DELIVERY_RIDER values to DRIVER.
%% There are no ROLES, USER_ROLES, or AUTH_TOKENS tables.
%% Payments currently exists only as a table; there is no payment JPA entity, provider, or callback code.
%% Extra current tables: store_applications, driver_applications, application_documents, application_review_history.
%% PLANNED FUTURE TABLES (not created by V1-V3): carts, cart_items, products, stores, categories, inventory,
%% inventory_reservations, inventory_adjustments, payment_callbacks, refunds, deliveries, drivers,
%% delivery_offers, driver_locations, notifications, processed_events, dead_letter_messages, audit_logs.
%% The planned stores/products/inventory tables are owned by other team members; no FKs to them exist yet.
